# --- Public (embedded in the browser bundle; never put secrets here) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Legacy JWT anon key, OR new publishable key (sb_publishable_…) — set at least one.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Used for auth redirects (e.g. password reset). Must match Supabase Auth redirect allow list — see project docs.
NEXT_PUBLIC_APP_URL=http://localhost:3042

# Optional: same Sentry DSN as below so the browser SDK can report errors (client bundle cannot read SENTRY_DSN).
NEXT_PUBLIC_SENTRY_DSN=

# Widget/public embed settings (optional; safe for client bundle).
# Should match server `WIDGET_API_KEY` when widget API key enforcement is enabled.
NEXT_PUBLIC_WIDGET_API_KEY=
# Default dealership slug for `/widget` route (`?slug=` overrides this value).
NEXT_PUBLIC_WIDGET_DEALERSHIP_SLUG=sault-nissan
# Optional explicit API origin for cross-domain widget embeds (empty = NEXT_PUBLIC_APP_URL).
NEXT_PUBLIC_WIDGET_API_ORIGIN=
# Widget copy and contact info.
NEXT_PUBLIC_WIDGET_AFTER_HOURS_MESSAGE=
NEXT_PUBLIC_WIDGET_WELCOME_MESSAGE=
NEXT_PUBLIC_WIDGET_CONTACT_PHONE_TEL=
NEXT_PUBLIC_WIDGET_CONTACT_PHONE_LABEL=
NEXT_PUBLIC_WIDGET_CONTACT_EMAIL=

# --- Server-only (never prefix with NEXT_PUBLIC_; never expose to the client) ---
SUPABASE_SERVICE_ROLE_KEY=

# Twilio (server-only — never NEXT_PUBLIC_*). Validated at dev boot + via getTwilioServerEnv() / getServerEnv().
# TWILIO_ACCOUNT_SID — Twilio Console → Account; used by REST SDK (with auth token).
TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN — primary auth token; webhook signature validation + REST API.
TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER — E.164 default From line + inbound To fallback for single dealership; e.g. +17055550100
TWILIO_PHONE_NUMBER=
# Optional: full URL for Twilio delivery status POSTs (statusCallback on outbound sends).
TWILIO_STATUS_CALLBACK_URL=

# Optional: bearer token for POST /api/webhooks/telephony/missed-call (empty disables route).
MISSED_CALL_WEBHOOK_SECRET=
# Optional override for default missed-call follow-up SMS.
MISSED_CALL_FOLLOWUP_SMS=

OPENAI_API_KEY=
# OpenAI-compatible Chat Completions root (no trailing slash). Must include the `/v1` segment used by that host.
# Default when unset: https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# Groq (often very low cost): use key from console.groq.com and a Groq model id in AI_MODEL.
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter (multiple providers): key + model slug from openrouter.ai; confirm JSON mode / response_format support for your model.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Optional inbound AI tuning controls.
AI_MODEL=gpt-4o-mini
AI_CONFIDENCE_THRESHOLD=0.65
AI_INBOUND_CLASSIFICATION_ENABLED=true
# Reserved (not implemented): keep false unless explicitly wired.
AI_AUTO_SEND_REPLIES=false

# After-hours web widget: allow one sanitized AI acknowledgement to the customer (set to "false" to disable).
AI_SERVICE_AFTER_HOURS_AUTOREPLY=true

SENTRY_DSN=

# Optional: webhook for "needs human" handoff alerts (Slack/Zapier/Teams/email relay).
# App POSTs JSON when AI escalates a conversation to waiting_for_human.
SALES_HANDOFF_WEBHOOK_URL=

# Meta (Messenger / Instagram webhooks + future Graph outbound). Validated when Meta webhook handlers run (getMetaWebhookEnv).
# META_APP_SECRET — App Dashboard → App settings → Basic → App secret (signs webhook POST body).
# META_VERIFY_TOKEN — arbitrary string you set; must match the token configured on the webhook subscription in Meta.
# META_PAGE_ACCESS_TOKEN — Graph API page token for Messenger sends (not used by POST webhook yet).
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=

# Optional: set to 1 only for special CI/build cases where env cannot be injected (not for production runtime).
# SKIP_ENV_VALIDATION=1
